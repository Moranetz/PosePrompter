import Foundation

enum Config {
    
    // MARK: - API Configuration
    
    /// Base URL for the backend API
    static var apiBaseURL: String {
        #if DEBUG
        // DEVELOPMENT CONFIGURATION
        
        // For iOS Simulator - use localhost
        return "http://localhost:3001"
        
        // For physical device - uncomment and use your computer's IP address
        // Find your IP: Run `ipconfig` (Windows) or `ifconfig | grep "inet "` (Mac/Linux)
        // return "http://192.168.1.100:3001"
        
        #else
        // PRODUCTION CONFIGURATION
        
        // TODO: Replace with your production server URL
        return "https://api.poseprompt.studio"
        
        #endif
    }
    
    // MARK: - Stripe Configuration
    
    /// Stripe publishable key
    /// Get your keys from: https://dashboard.stripe.com/apikeys
    static var stripePublishableKey: String {
        #if DEBUG
        // Test mode - Get from Stripe Dashboard > Developers > API Keys
        return "pk_test_PASTE_YOUR_TEST_KEY_HERE"
        
        #else
        // Live mode - Get from Stripe Dashboard > Developers > API Keys
        // IMPORTANT: Only add this before App Store submission
        return "pk_live_PASTE_YOUR_LIVE_KEY_HERE"
        
        #endif
    }
    
    // MARK: - API Endpoints
    
    enum Endpoint {
        // Backend health check
        static let health = "/api/health"
        
        // Authentication endpoints
        static let auth = "/api/auth"
        static let login = "/api/auth/login"
        static let register = "/api/auth/register"
        
        // User endpoints
        static let users = "/api/users"
        static let profile = "/api/users/profile"
        
        // Pose endpoints (customize based on your API)
        static let poses = "/api/poses"
        static let createPose = "/api/poses/create"
        static let myPoses = "/api/poses/my"
        
        // Subscription endpoints
        static let subscription = "/api/subscription"
        static let createSubscription = "/api/subscription/create"
        static let cancelSubscription = "/api/subscription/cancel"
        
        // Payment endpoints
        static let payment = "/api/payment"
        static let createPaymentIntent = "/api/payment/intent"
        
        // TODO: Add your custom endpoints here
    }
    
    // MARK: - App Configuration
    
    /// App version (automatically read from Info.plist)
    static var appVersion: String {
        Bundle.main.infoDictionary?["CFBundleShortVersionString"] as? String ?? "1.0.0"
    }
    
    /// Build number (automatically read from Info.plist)
    static var buildNumber: String {
        Bundle.main.infoDictionary?["CFBundleVersion"] as? String ?? "1"
    }
    
    /// Bundle identifier (automatically read from Info.plist)
    static var bundleIdentifier: String {
        Bundle.main.bundleIdentifier ?? "com.poseprompt.studio"
    }
    
    // MARK: - Feature Flags
    
    /// Toggle features on/off during development
    enum Features {
        /// Enable offline mode (cache data locally)
        static let offlineMode = true
        
        /// Enable analytics tracking
        static let analytics = true
        
        /// Enable push notifications
        static let pushNotifications = true
        
        /// Enable haptic feedback
        static let haptics = true
        
        /// Enable debug logging
        static let debugLogging = true
        
        // TODO: Add your custom feature flags
    }
    
    // MARK: - Cache Configuration
    
    enum Cache {
        /// Cache expiration time in seconds
        static let expirationTime: TimeInterval = 3600 // 1 hour
        
        /// Maximum cache size in bytes
        static let maxSize: Int = 100 * 1024 * 1024 // 100 MB
        
        /// Enable image caching
        static let enableImageCache = true
    }
    
    // MARK: - UI Configuration
    
    enum UI {
        /// Number of items per page in lists
        static let itemsPerPage = 20
        
        /// Animation duration
        static let animationDuration: TimeInterval = 0.3
        
        /// Image quality for uploads (0.0 - 1.0)
        static let imageQuality: CGFloat = 0.8
    }
}

// MARK: - Helper Extensions

extension Config {
    
    /// Check if running in debug mode
    static var isDebug: Bool {
        #if DEBUG
        return true
        #else
        return false
        #endif
    }
    
    /// Check if running in simulator
    static var isSimulator: Bool {
        #if targetEnvironment(simulator)
        return true
        #else
        return false
        #endif
    }
    
    /// Full app version string (e.g., "1.0.0 (1)")
    static var fullVersion: String {
        "\(appVersion) (\(buildNumber))"
    }
}
