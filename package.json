{
  "name": "poseprompt-studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "cd server && npm run dev",
    "dev:all": "concurrently \"npm run dev:server\" \"npm run dev\" --names \"backend,frontend\" --prefix-colors \"cyan,green\"",
    "start": "powershell -ExecutionPolicy Bypass -File ./start-servers.ps1",
    "check": "powershell -ExecutionPolicy Bypass -File ./check-servers.ps1",
    "stop": "powershell -ExecutionPolicy Bypass -File ./stop-servers.ps1",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^2.4.0",
    "@stripe/stripe-js": "^2.4.0",
    "firebase": "^10.13.2",
    "framer-motion": "^10.16.16",
    "lucide-react": "^0.426.0",
    "posthog-js": "^1.372.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^8.2.2",
    "esbuild": "^0.27.0",
    "jsdom": "^23.0.1",
    "vite": "^5.4.21",
    "vitest": "^1.1.0"
  }
}
